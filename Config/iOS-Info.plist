<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Browsing for the companion needs the service listed here. Xcode's
	     INFOPLIST_KEY_ build settings cannot express an array, so this partial
	     plist is merged with the generated one. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_dissappear._tcp</string>
	</array>
	<!-- Keeps the app running while it spoofs this phone by itself. The spoof
	     lasts only as long as the app's connection to the device; suspended,
	     the heartbeat goes unanswered and iOS drops it. -->
	<!-- Lets the Mac companion drop a pairing record into Documents over USB
	     when the whole container cannot be vended. It is removed on pickup. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
</dict>
</plist>
